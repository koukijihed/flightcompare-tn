# ---------------------------------------------------------------------------
# FlightCompare TN - environment template
# Copy to .env and adjust values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# PostgreSQL (Docker Compose)
# Host port is 5433 by default to avoid the native PostgreSQL service on 5432.
POSTGRES_PORT=5433
POSTGRES_DB=flightcompare_tn
POSTGRES_USER=flightcompare
POSTGRES_PASSWORD=flightcompare_dev_2026
DATABASE_URL="postgresql://flightcompare:flightcompare_dev_2026@localhost:5433/flightcompare_tn?schema=public"

# ---- Flight providers -----------------------------------------------------
# Real offers come from Travelpayouts (Aviasales) or another configured live
# provider. Without credentials the app returns a clear "no provider" message:
# it never fabricates offers in production.
#
# Travelpayouts: create a free affiliate account at https://travelpayouts.com/
# Copy the API token and affiliate marker from your account. The real-time
# Flights Search API must be requested/approved separately:
# https://support.travelpayouts.com/hc/en-us/requests/new
TRAVELPAYOUTS_TOKEN=""
TRAVELPAYOUTS_MARKER=""
TRAVELPAYOUTS_BASE_URL="https://api.travelpayouts.com"
# Public hostname of the deployed site (defaults to APP_URL's host).
TRAVELPAYOUTS_HOST=""
# fr | en-us | en-gb | ru | de | es | pl
TRAVELPAYOUTS_LOCALE="fr"
TRAVELPAYOUTS_CURRENCY="EUR"
# Search API tuning (the endpoint expires after 15 minutes).
TRAVELPAYOUTS_POLL_INTERVAL_MS=700
TRAVELPAYOUTS_MAX_POLLS=8
# Only for local testing behind a public IP (Travelpayouts refuses localhost).
TRAVELPAYOUTS_USER_IP=""

# Amadeus (optional alternative live provider)
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
# Sandbox: https://test.api.amadeus.com   Production: https://api.amadeus.com
AMADEUS_BASE_URL="https://test.api.amadeus.com"
# Demo offers are opt-in only. Keep false for a production site.
DEMO_MODE=false
# Search tuning
PROVIDER_TIMEOUT_MS=9000
PROVIDER_MAX_OFFERS=25

# Skyscanner requires a commercial agreement + API approval.
# Leave empty unless you have official partner access.
SKYSCANNER_API_KEY=""
SKYSCANNER_BASE_URL=""

# ---- Transactional e-mail (Resend) ----------------------------------------
# Used for password reset and price-alert notifications.
# https://resend.com/api-keys — verify your sending domain first.
RESEND_API_KEY=""
EMAIL_FROM="FlightCompare TN <noreply@your-domain.tn>"
EMAIL_REPLY_TO=""

# ---- Scheduled price monitoring -------------------------------------------
# Protect /api/cron/monitor. Vercel Cron sends this as a Bearer token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ---- AI (OpenAI-compatible) ----------------------------------------------
# Optional. Without a key the AI features fall back to a deterministic
# rule-based parser/assistant and never fabricate offers.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# ---- Currency -------------------------------------------------------------
# Optional live FX endpoint returning {"rates": {"TND": 3.4, ...}, ...}
# When empty, indicative static rates stored in the database are used.
EXCHANGE_RATE_API_URL=""
EXCHANGE_RATE_BASE="EUR"

# ---- Price monitoring -----------------------------------------------------
# How many alerts one monitoring run may process, and request spacing.
MONITOR_MAX_ALERTS=25
MONITOR_DELAY_MS=1500
