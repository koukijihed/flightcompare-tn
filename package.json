    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "i18n:audit": "tsx scripts/audit-i18n.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
