{
  "name": "flightcompare-tn",
  "version": "1.0.0",
  "private": true,
  "description": "FlightCompare TN - Intelligent flight price comparison platform for Tunisia",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
