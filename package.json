    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
